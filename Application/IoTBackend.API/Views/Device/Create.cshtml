@model IoTBackend.Core.Entities.Device

@{
    ViewData["Title"] = "Add New Device";
}

<link rel="stylesheet" href="~/css/Device/Create.css" />

<div class="form-container-wrapper">
    <div class="header-section">
        <h1 class="page-title">Define New Device</h1>
    </div>

    <div class="form-card">
        <form action="/Device/Create" method="post">
            
            <div class="form-group">
                <label class="form-label">Device Name</label>
                <input type="text" name="Name" required class="form-control" placeholder="e.g., STM32 Main Controller" />
            </div>

            <div class="form-group">
                <label class="form-label">MAC Address / Serial Port</label>
                <input type="text" name="MacAddress" required class="form-control" placeholder="e.g., /dev/ttyACM0" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">
                    Save Device
                </button>
                <a href="/Device/Index" class="btn btn-cancel">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>