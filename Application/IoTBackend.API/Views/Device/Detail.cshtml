@using IoTBackend.Core.Entities
@model IEnumerable<TelemetryRecord>

@{
    ViewData["Title"] = "Telemetry Data";
}

<link rel="stylesheet" href="~/css/Device/Detail.css" />

<div class="page-container">
    
    <div class="header-section">
        <h1 class="page-title">Telemetry Data <span class="text-muted">(Device ID: @ViewBag.DeviceId)</span></h1>
        
        <a href="/Telemetry/Create?deviceId=@ViewBag.DeviceId" class="btn-primary">
            + Add New Telemetry
        </a>
    </div>

    <!-- Table Section -->
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Measurement Type</th>
                    <th>Value</th>
                    <th>Time Stamp</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="font-bold">@item.MeasurementType</td>
                            <td class="font-bold text-highlight">@item.Value</td>
                            <td>@item.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-list">No telemetry records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>