@model IEnumerable<IoTBackend.Core.Entities.Device>

@{
    ViewData["Title"] = "Device List";
}

<link rel="stylesheet" href="~/css/Device/Index.css" />

<div class="page-container">
    <div class="header-section">
        <h1 class="page-title">Connected Devices</h1>
        <a href="/Device/Create" class="btn-primary">
            + Add New Device
        </a>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-id text-center">ID</th>
                    <th class="col-name">Device Name</th>
                    <th class="col-mac">MAC Address / Port</th>
                    <th class="col-status text-center">Status</th>
                    <th class="col-action text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-list">No registered devices found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td class="font-bold">@item.Name</td>
                            <td class="text-mono text-muted">@item.MacAddress</td>
                            <td class="text-center">
                                <span class="status-badge status-active">Active</span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Device" asp-action="Detail" asp-route-id="@item.Id" class="btn-action">Details</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>