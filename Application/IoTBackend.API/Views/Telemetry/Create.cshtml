@using IoTBackend.Core.Entities
@model TelemetryRecord

@{
    ViewData["Title"] = "Yeni Telemetri Kaydı";
    var deviceId = ViewBag.DeviceId;
}

    <link rel="stylesheet" href="~/css/Telemetry/Create.css" />

<div class="create-telemetry-container">
    <h1 class="page-title">Yeni Telemetri Ekle</h1>
    <p class="subtitle">Cihaz ID: <strong>@deviceId</strong> için veri girişi yapıyorsunuz.</p>

    <div class="form-card">
        <form action="/Telemetry/Create" method="post">
            
            <input type="hidden" name="DeviceId" value="@deviceId" />

            <div class="form-group">
                <label>Ölçüm Türü (Measurement Type)</label>
                <input type="text" name="MeasurementType" required placeholder="Örn: Sicaklik, Nem, Basinc..." />
            </div>

            <div class="form-group">
                <label>Değer (Value)</label>
                <input type="text" name="Value" required placeholder="Örn: 24.5" />
            </div>
            <div class="button-group">
                <button type="submit" class="btn-submit">Kaydet</button>
                <a href="/Device/Detail/@deviceId" class="btn-cancel">İptal</a>
            </div>
        </form>
    </div>
</div>