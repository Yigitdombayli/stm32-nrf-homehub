@using IoTBackend.Core.Entities
@model TelemetryRecord

@{
    ViewData["Title"] = "Add New Telemetry";
    var deviceId = ViewBag.DeviceId;
}

<link rel="stylesheet" href="~/css/Telemetry/Create.css" />

<div class="form-container-wrapper">
    <div class="header-section">
        <h1 class="page-title">Add New Telemetry</h1>
        <p class="subtitle">Entering data for Device ID: <strong>@deviceId</strong></p>
    </div>

    <div class="form-card">
        <form action="/Telemetry/Create" method="post">
            
            <input type="hidden" name="DeviceId" value="@deviceId" />

            <div class="form-group">
                <label class="form-label">Measurement Type</label>
                <input type="text" name="MeasurementType" required class="form-control" placeholder="e.g., Temperature, Humidity, Pressure..." />
            </div>

            <div class="form-group">
                <label class="form-label">Value</label>
                <input type="text" name="Value" required class="form-control" placeholder="e.g., 24.5" />
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn btn-save">Save</button>
                <a href="/Device/Detail/@deviceId" class="btn btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>