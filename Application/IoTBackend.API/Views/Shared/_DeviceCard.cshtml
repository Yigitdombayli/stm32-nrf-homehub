@using IoTBackend.Core.Entities
@model Device

<div class="device-card">
    <div class="device-header">
        <h3 class="device-name">@Model.Name</h3>
        <span class="device-mac">ID: @Model.Id | @Model.MacAddress</span>
    </div>
    
    <div class="telemetry-list">
        @if(Model.TelemetryRecords != null && Model.TelemetryRecords.Any())
        {
            foreach(var tel in Model.TelemetryRecords)
            {
                <div class="telemetry-item">
                    <span class="tel-type">@tel.MeasurementType</span>
                    <span class="tel-value" id="val-@tel.Id">@tel.Value</span>
                </div>
            }
        }
        else
        {
            <div class="empty-telemetry">No data available</div>
        }
    </div>

    <div class="device-controls" style="margin-top: 15px;">
        <h4 class="control-title">Room @Model.Id Controls</h4> 
        <div class="button-group">
            <button data-room="@Model.Id" data-led="0" type="button" class="btn btn-secondary toggle-btn">
                LED 1 (OFF)
            </button>

            <button data-room="@Model.Id" data-led="1" type="button" class="btn btn-secondary toggle-btn">
                LED 2 (OFF)
            </button>
        </div>
    </div>

    <div class="device-controls" style="margin-top: 15px;">
    <h4 class="control-title">Room @Model.Id Temperature</h4> 
    <div class="input-group" style="display: flex; gap: 10px;">
        <input type="number" id="targetTemp-@Model.Id" class="form-control" placeholder="Ex: 25" style="width: 100px;">
        <button data-room="@Model.Id" type="button" class="btn btn-primary set-temp-btn">
            Set
        </button>
    </div>
    </div>
    <div class="device-actions" style="margin-top: 15px;">
        <a href="/Telemetry/Create?deviceId=@Model.Id" class="btn-action btn-secondary">
            + Telemetry
        </a>
        <a href="/Device/Detail/@Model.Id" class="btn-action btn-primary">
            Details
        </a>
    </div>
</div>