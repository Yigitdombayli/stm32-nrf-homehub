@using IoTBackend.Core.Entities
@model IEnumerable<Device>

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/Dashboard/Index.css" />

<div class="dashboard-container">
    <h1 class="page-title">System Overview</h1>
    
    <div class="dashboard-grid">
        
        @if (Model != null)
        {
            foreach (var device in Model)
            {
                <partial name="_DeviceCard" model="device" />
            }
        }

        <a href="/Device/Create" class="add-device-card">
            <div class="add-icon">+</div>
            <span class="add-text">Add New Device</span>
        </a>

    </div>
</div>
<script src="~/js/Dashboard/TelemetryValue.js"></script>